scores = []
for i in range(1, 6):
   score = float(input(f"Enter score for student {i}: "))
   scores.append(score)
print("\nExam Results")
for i, score in enumerate(scores, start=1):
   if score >= 50:
       result = "Pass"
   else:
       result = "Fail"
   print(f"Student {i}: Score {score} -> {result}")